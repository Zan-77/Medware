{"nodes": [{"id": "4th_8_commit_email_based_login", "label": "Email-Based Login", "file_type": "concept", "source_file": "4th-8-commit.txt", "source_location": "What added", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The token serializer resolves a user by email OR username so existing username-based clients keep working while email login is added - backward compatibility was an explicit constraint."}, {"id": "4th_8_commit_httponly_refresh_cookie", "label": "HttpOnly Refresh Cookie", "file_type": "rationale", "source_file": "4th-8-commit.txt", "source_location": "Security posture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The refresh cookie is HttpOnly so client-side JS cannot read it, SameSite=Lax to blunt CSRF, and Secure is enabled outside DEBUG so production requires HTTPS while local development over http still works."}, {"id": "4th_8_commit_cookie_refresh_flow", "label": "Cookie-Based Refresh Flow", "file_type": "concept", "source_file": "4th-8-commit.txt", "source_location": "what changed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The refresh route reads the refresh token from the cookie instead of the request body, so the frontend can obtain a new access token without ever storing the refresh token in client-side JavaScript."}, {"id": "4th_8_commit_logout_endpoint", "label": "Logout Endpoint", "file_type": "concept", "source_file": "4th-8-commit.txt", "source_location": "What added", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "4th_8_commit_refresh_cookie_rotation", "label": "Refresh Cookie Rotation", "file_type": "concept", "source_file": "4th-8-commit.txt", "source_location": "what changed", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "4th_8_commit_auth_regression_tests", "label": "Auth Flow Regression Tests", "file_type": "c